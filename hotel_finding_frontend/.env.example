# Frontend environment configuration
# Copy this file to ".env" and fill in values as needed.

# Base API URL for real backend (e.g., https://api.example.com). If empty, app will call relative paths (and MSW can intercept).
REACT_APP_API_BASE=

# Force-enable Mock Service Worker for local development or demo.
# true -> MSW will intercept /hotels and return mock data even in production builds.
# false/empty -> MSW runs only in development by default.
REACT_APP_ENABLE_MSW=false

# Google Maps JavaScript API key. If unset/invalid, the map will show a loader/fallback and not render.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional settings commonly used across environments. Safe defaults are provided.
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Healthcheck path that the app can fetch to verify runtime status (frontend only check).
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags as JSON or comma-separated list. Examples:
# JSON: {"newSidebar": true, "betaMap": false}
# List: newSidebar,betaMap
REACT_APP_FEATURE_FLAGS={}

# Experiments toggle (not used directly by app code yet).
REACT_APP_EXPERIMENTS_ENABLED=false
