# Backend base URL (optional). If omitted, the app uses relative /hotels with MSW in dev.
REACT_APP_API_BASE=
# Alternative backend URL key supported:
REACT_APP_BACKEND_URL=

# Enable Mock Service Worker even in production-like tests
REACT_APP_ENABLE_MSW=true

# Google Maps JavaScript API key (do not commit actual key)
REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional feature flags (JSON or comma-separated keys)
REACT_APP_FEATURE_FLAGS={"exampleFlag":true}

# Other container-provided envs (documented)
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=
REACT_APP_NEXT_TELEMETRY_DISABLED=
REACT_APP_ENABLE_SOURCE_MAPS=
REACT_APP_PORT=
REACT_APP_TRUST_PROXY=
REACT_APP_LOG_LEVEL=
REACT_APP_HEALTHCHECK_PATH=
REACT_APP_EXPERIMENTS_ENABLED=
